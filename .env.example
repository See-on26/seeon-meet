# SEEON 환경 변수 예시 — `cp .env.example .env` 후 값을 채운다. .env 는 커밋하지 않는다(.gitignore).
# 값을 비워 두면 기본값을 쓴다. 각 값의 뜻은 docs/development.md 의 「환경 변수」 표에 있다.

# --- 화면 해설 AI 서버 (기본은 127.0.0.1 의 8801~8805) ---
# SEEON_VLM_URL=http://127.0.0.1:8801/v1/chat/completions
# SEEON_VLM_MODEL=gemma-4-26b-a4b-qat
# SEEON_ASR_URL=http://127.0.0.1:8802/asr
# SEEON_TTS_URL=http://127.0.0.1:8803/tts
# SEEON_JUDGE_GPU_MODEL=gemma-4-26b-a4b-qat
# SEEON_GAP_SOURCE=asr
# SEEON_SLIDE_TEXT_BACKEND=vlm

# --- GPU 서버로 가는 SSH 터널 (앱이 켜질 때 직접 연다) ---
# 주소·계정·호스트 키 지문·키 경로를 모두 채워야 터널을 연다. 실제 값은 저장소에 두지 않는다.
# 포트를 비우면 SSH 기본 포트(22)로 붙는다. 이미 다른 터널이 8801~8805 를 쓰고 있으면 그 터널을 쓴다.
SEEON_GPU_SSH_HOST=
SEEON_GPU_SSH_PORT=
SEEON_GPU_SSH_USER=
SEEON_GPU_SSH_HOST_FINGERPRINT=
SEEON_GPU_SSH_KEY=
# SEEON_GPU_TUNNEL=off
