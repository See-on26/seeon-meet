# 캡션 파이프라인 환경변수 템플릿
# 이 파일을 .env로 복사해서 값을 채우세요:  cp .env.example .env
# .env는 git에 커밋되지 않습니다(.gitignore). 셸에서 넘긴 값이 .env보다 우선합니다.
# 아래 값은 모두 "기본값"이라, 목 서버(npm run mock)로 돌릴 때는 .env가 없어도 됩니다.

# --- GPU 서버 엔드포인트 (SSH 터널이면 localhost 그대로) ---
# SEEON_VLM_MODEL은 서버의 --served-model-name과 정확히 같아야 합니다(다르면 404).
# 확인: curl http://127.0.0.1:8801/v1/models
SEEON_VLM_URL=http://127.0.0.1:8801/v1/chat/completions
SEEON_VLM_MODEL=qwen3.5-35b-a3b
SEEON_ASR_URL=http://127.0.0.1:8802/asr
SEEON_TTS_URL=http://127.0.0.1:8803/tts
# 회의 요약본 전문을 mp3 하나로 받는 별도 경로(같은 포트, 다른 엔드포인트).
# 실시간 캡션의 /tts에 mp3 인코딩을 붙이면 지연과 삽입 타이밍이 어긋나므로 나눠 두었습니다.
# SEEON_TTS_LONG_URL=http://127.0.0.1:8803/tts-long
SEEON_EMBED_URL=http://127.0.0.1:8804/embed

# --- AWS Bedrock (라우터·판정기·틈 추론) ---
# 비우면 규칙 기반 fallback으로 동작합니다. bearer token을 넣으면 Bedrock Sonnet 사용.
SEEON_BEDROCK_REGION=us-east-1
# 모든 Bedrock 호출의 기준 모델. 지정하지 않은 하위 경로는 이 값을 따릅니다.
# anthropic.claude-sonnet-5도 호출됩니다(2026-08-03 실측). 다만 라우터의 오프라인 A/B는
# 4-6·temperature 0에서 측정된 값이라, 상향 시 tools/deixis-eval.mjs를 다시 돌려야 합니다.
SEEON_BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6
# 판정 경로만 다른 체급으로 갈라 쓸 때만 지정합니다(미지정 시 위 기준 모델을 따름):
# SEEON_BEDROCK_JUDGE_MODEL_ID=anthropic.claude-haiku-4-5
# 회의 요약 전용 모델. 기준 모델을 따르지 않고 독립 기본값(opus-4-7)을 갖습니다 —
# 실시간 판정을 저렴한 체급으로 낮춰도 요약 품질까지 함께 떨어지면 안 되기 때문입니다.
# SEEON_BEDROCK_SUMMARY_MODEL_ID=anthropic.claude-opus-4-7
# 발화 축 판정 경로: unified(기본) | judge
# SEEON_ROUTER_MODE=unified
# AWS Bedrock 콘솔에서 발급한 API 키(bearer token)를 넣으세요:
# AWS_BEARER_TOKEN_BEDROCK=
# (또는 IAM 자격증명 방식: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, 또는 AWS_PROFILE)

# --- SSH 터널 (tools/tunnel.sh 실행 시 사용, 앱 자체는 참조하지 않음) ---
# GPU_SSH_HOST=gpu.example.com
# GPU_SSH_USER=ubuntu
# GPU_SSH_PASSWORD=
# 서버 서비스 포트가 다르면 (tunnel.sh가 참조):
# SEEON_VLM_PORT=8801
# SEEON_ASR_PORT=8802
# SEEON_TTS_PORT=8803
# SEEON_EMBED_PORT=8804

# --- 캡션 비교용 외부 VLM (tools/harvest/fill-external.mjs) ---
# GPT: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- 캡션 비교용 Bedrock VLM (표의 ④·⑤ 열) ---
# 위의 AWS_BEARER_TOKEN_BEDROCK를 그대로 씁니다 — 별도 키 발급이 필요 없습니다.
# 로컬 VLM이 프롬프트 탓인지 체급 탓인지 가르는 대조군입니다(model-reassessment.md §3).
# ⑥·⑦은 GPT·Gemini 무료 등급 쿼터를 대신하는 타 벤더 대조군입니다.
BEDROCK_CLAUDE_MODEL=anthropic.claude-opus-4-7
BEDROCK_QWEN_MODEL=qwen.qwen3-vl-235b-a22b
BEDROCK_NOVA_MODEL=amazon.nova-pro-v1:0
BEDROCK_LLAMA_MODEL=meta.llama4-maverick-17b-instruct-v1:0
