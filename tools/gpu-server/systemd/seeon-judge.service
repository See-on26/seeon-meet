[Unit]
Description=seeon JUDGE (vLLM Gemma 4 26B-A4B-it QAT 4bit, 탐지 판정 LLM)
After=network-online.target seeon-vlm.service
Wants=network-online.target

[Service]
User=@GPU_USER@
Environment=HOME=/home/@GPU_USER@
Environment=HF_HOME=/data/hf-cache
# 받아 둔 리비전만 쓴다. 기동 때 Hugging Face 에 묻지 않아 파일이 바뀌거나 받기가 실패해도 영향이 없다.
Environment=HF_HUB_OFFLINE=1
# vLLM 의 익명 사용 통계(stats.vllm.ai) 전송을 끈다.
Environment=VLLM_NO_USAGE_STATS=1
Environment=DO_NOT_TRACK=1
# 같은 모델을 8801(이미지 있음)에도 띄우므로 컴파일 캐시를 자리마다 나눈다. 같이 쓰면 서로의 캐시를 읽고 기동이 죽는다(vLLM #50891).
Environment=VLLM_CACHE_ROOT=/home/@GPU_USER@/.cache/vllm-gemma4-judge
Environment=CUDA_HOME=/data/venv-vllm-35/lib/python3.12/site-packages/nvidia/cu13
Environment=PATH=/data/venv-vllm-35/lib/python3.12/site-packages/nvidia/cu13/bin:/data/venv-vllm-35/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=VLLM_USE_FLASHINFER_SAMPLER=0
WorkingDirectory=/home/@GPU_USER@/gpu-server
# 두 vLLM 이 동시에 메모리를 재면 서로의 예약을 못 봐 기동이 실패한다. VLM(8801)이 뜬 뒤에 올린다(최대 10분 대기).
ExecStartPre=/bin/bash -c 'for i in $(seq 1 120); do curl -sf http://127.0.0.1:8801/v1/models >/dev/null && exit 0; sleep 5; done; exit 0'
TimeoutStartSec=900
# 판단은 글만 쓴다. --language-model-only 로 비전 타워를 올리지 않아 그만큼 KV 캐시가 늘어난다.
ExecStart=/data/venv-vllm-35/bin/vllm serve cyankiwi/gemma-4-26B-A4B-it-qat-AWQ-INT4 --revision 18a3c7285c33ee39d3e5e16ee6fb2c18f4955ef9 --served-model-name gemma-4-26b-a4b-qat --host 127.0.0.1 --port 8805 --max-model-len 8192 --gpu-memory-utilization 0.30 --language-model-only --reasoning-parser gemma4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
