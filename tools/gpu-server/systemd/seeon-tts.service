[Unit]
Description=seeon TTS (MeloTTS-Korean)
After=network-online.target
Wants=network-online.target

[Service]
User=tta
Environment=HOME=/home/tta
WorkingDirectory=/home/tta/gpu-server
ExecStart=/home/tta/venv-audio/bin/uvicorn tts_server:app --host 127.0.0.1 --port 8803
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
