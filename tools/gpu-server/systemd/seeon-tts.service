[Unit]
Description=seeon TTS (MeloTTS-Korean)
After=network-online.target
Wants=network-online.target

[Service]
User=@GPU_USER@
Environment=HOME=/home/@GPU_USER@
WorkingDirectory=/home/@GPU_USER@/gpu-server
ExecStart=/home/@GPU_USER@/venv-audio/bin/uvicorn tts_server:app --host 127.0.0.1 --port 8803
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
